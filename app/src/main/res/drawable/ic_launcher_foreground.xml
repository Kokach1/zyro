<?xml version="1.0" encoding="utf-8"?>
<!--
    Zyro adaptive icon – foreground layer.
    Propeller-circle symbol (the "o" glyph from the Zyro wordmark).
    Centred at (54,54) in the 108×108 adaptive-icon canvas.
    Outer radius 27 dp → 54 dp diameter, well inside the 72 dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring: outer R=27, inner R=21, centre (54,54), 6 dp stroke -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M54,27  A27,27,0,1,1,53.999,27 Z
            M54,33  A21,21,0,1,0,54.001,33 Z"/>

    <!-- Four propeller blades (cubic-bezier petals, hub→ring) -->

    <!-- Top blade -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M54,49 C48,45 48,38 54,35 C60,38 60,45 54,49 Z"/>

    <!-- Right blade -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M59,54 C63,48 70,48 73,54 C70,60 63,60 59,54 Z"/>

    <!-- Bottom blade -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M54,59 C60,63 60,70 54,73 C48,70 48,63 54,59 Z"/>

    <!-- Left blade -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M49,54 C45,48 38,48 35,54 C38,60 45,60 49,54 Z"/>

    <!-- Centre hub dot, R=3 -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M54,51 A3,3,0,1,1,53.999,51 Z"/>

</vector>
